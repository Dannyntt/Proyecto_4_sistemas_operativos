+// Atiende un fallo de escritura en la página de va si es copy-on-write.
+// Si la página tiene más de una referencia, el proceso recibe una copia
+// propia; si es la única referencia, solo recupera el permiso de escritura.
+// Devuelve 0 si resolvió el fallo, -1 si la página no es CoW o si no hay
+// memoria para la copia (en ese caso el llamador mata al proceso).
+int
+cowfault(pagetable_t pagetable, uint64 va)
+{
+  pte_t *pte;
+  uint64 pa;
+  uint flags;
+  char *mem;
+  struct proc *p = myproc();
+
+  if (va >= MAXVA)
+    return -1;
+  va = PGROUNDDOWN(va);
+  pte = walk(pagetable, va, 0);
+  if (pte == 0 || (*pte & PTE_V) == 0 || (*pte & PTE_U) == 0 ||
+      (*pte & PTE_COW) == 0)
+    return -1;
+
+  pa = PTE2PA(*pte);
+  flags = (PTE_FLAGS(*pte) | PTE_W) & ~PTE_COW;
+  p->cowfaults++;
+
+  // Con una sola referencia nadie más puede subir el conteo (solo este
+  // proceso apunta a la página), así que no hace falta copiar. Si otro
+  // proceso baja el conteo justo ahora, lo peor es una copia de más.
+  if (krefcount((void *)pa) == 1) {
+    *pte = PA2PTE(pa) | flags;
+    return 0;
+  }
+
+  if ((mem = kalloc()) == 0)
+    return -1;
+  memmove(mem, (char *)pa, PGSIZE);
+  *pte = PA2PTE(mem) | flags;
+  kfree((void *)pa); // quita la referencia de este proceso a la página vieja
+  p->cowcopies++;
+  return 0;
+}
