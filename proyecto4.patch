+// Agrega una referencia a una página que ya está en uso.
+void
+krefinc(void *pa)
+{
+  if (((uint64)pa % PGSIZE) != 0 || (char *)pa < end || (uint64)pa >= PHYSTOP)
+    panic("krefinc");
+
+  acquire(&refs.lock);
+  if (refs.count[PAGEIDX(pa)] < 1)
+    panic("krefinc: página libre");
+  refs.count[PAGEIDX(pa)]++;
+  release(&refs.lock);
+}
+
+// Número de referencias a la página pa.
+int
+krefcount(void *pa)
+{
+  int n;
+
+  acquire(&refs.lock);
+  n = refs.count[PAGEIDX(pa)];
+  release(&refs.lock);
+  return n;
+}
+
+// Páginas físicas libres en todo el sistema.
+uint64
+kfreepages(void)
+{
+  uint64 n;
+
+  acquire(&kmem.lock);
+  n = kmem.nfree;
+  release(&kmem.lock);
+  return n;
+}
+
+// Páginas físicas con más de una referencia.
+uint64
+ksharedpages(void)
+{
+  uint64 n = 0;
+
+  acquire(&refs.lock);
+  for (int i = 0; i < (PHYSTOP - KERNBASE) / PGSIZE; i++)
+    if (refs.count[i] > 1)
+      n++;
+  release(&refs.lock);
+  return n;
+}
