+  // 5. Páginas de la tabla que tocó el padre (antes de leer la tabla otra vez).
+  if(pgaccess(tabla, 64, &mascara) < 0)
+    morir("pgaccess() falló");
+  printf("snapshot: transferencias=%d aplicadas=%d rechazadas=%d\n",
+         m, aplicadas, rechazadas);
+  printf("snapshot: paginas_tocadas=%d fallos_cow=%ld copias_cow=%ld\n",
+         contar_bits(mascara), despues.cowfaults - antes.cowfaults,
+         despues.cowcopies - antes.cowcopies);
+
+  // 6. Esperar al hijo y verificar el archivo y la tabla.
+  int estado;
+  int ok = wait(&estado) == pid && estado == 0;
+  if(!ok)
+    printf("snapshot: el hijo no terminó bien\n");
+  if(!verificar_archivo(checksum_inicial))
+    ok = 0;
+
+  int conservado = saldo_total() == total_inicial;
+  if(!conservado)
+    ok = 0;
+  printf("snapshot: checksum_actual=0x%x total_conservado=%s\n",
+         checksum_tabla(tabla, NCUENTAS), conservado ? "si" : "no");
+  printf("snapshot: %s\n", ok ? "OK" : "FALLO");
+  exit(ok ? 0 : 1);
 }
 
